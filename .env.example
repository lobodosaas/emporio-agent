# Run locally without Cloudflare: copy to .env and set ONE key.
# The first key found is used; set LLM_PROVIDER to choose explicitly.
# Never commit .env.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# Optional:
# LLM_PROVIDER=anthropic        # anthropic | openai | openrouter | groq | deepseek
# LLM_MODEL=                    # override the provider's default model
# LLM_BASE_URL=                 # any other OpenAI-compatible endpoint
