{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emporio-agent",
  "main": "src/entry.py",
  // Newest date supported by the local workerd at build time.
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["python_workers"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    "MAX_OUTPUT_TOKENS": 900,
    "DAILY_LIMIT_PER_SESSION": 40,
    "DAILY_LIMIT_GLOBAL": 1500,
    "SHOW_TRACE": "true"
  },
  "ratelimits": [
    { "name": "RATE_LIMIT_SESSION", "namespace_id": "4101", "simple": { "limit": 8, "period": 60 } },
    { "name": "RATE_LIMIT_IP", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION", "class_name": "Conversation" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }],
  "observability": { "enabled": true }
}
